{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Generated schema for Root",
    "type": "object",
    "properties": {
        "@context": {
            "type": "string"
        },
        "@id": {
            "type": "string"
        },
        "@type": {
            "type": "string"
        },
        "totalItems": {
            "type": "number"
        },
        "member": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "@id": {
                        "type": "string"
                    },
                    "@type": {
                        "type": "string"
                    },
                    "identifiers": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "@id": {
                                    "type": "string"
                                },
                                "@type": {
                                    "type": "string"
                                },
                                "type": {
                                    "type": "object",
                                    "properties": {
                                        "@id": {
                                            "type": "string"
                                        },
                                        "@type": {
                                            "type": "string"
                                        },
                                        "title": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "@id",
                                        "@type",
                                        "title"
                                    ]
                                },
                                "value": {
                                    "type": "string"
                                },
                                "typedValue": {
                                    "type": ["string", "integer"]
                                }
                            },
                            "required": [
                                "@id",
                                "@type",
                                "type",
                                "value",
                                "typedValue"
                            ]
                        }
                    },
                    "createdAt": {
                        "type": "string",
                        "pattern": "\\d{4}-\\d{2}-\\d{2}\\D\\d{2}:\\d{2}:\\d{2}[+-]\\d{2}:\\d{2}"
                    },
                    "updatedAt": {
                        "type": "string",
                        "pattern": "\\d{4}-\\d{2}-\\d{2}\\D\\d{2}:\\d{2}:\\d{2}[+-]\\d{2}:\\d{2}"
                    }
                },
                "required": [
                    "@id",
                    "@type",
                    "identifiers",
                    "createdAt"
                ]
            }
        }
    },
    "required": [
        "@context",
        "@id",
        "@type",
        "totalItems",
        "member"
    ]
}
