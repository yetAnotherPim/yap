<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>

    <link rel="icon"
          href="{{ asset('images/favicon/favicon.svg') }}"
          type="image/svg+xml">

    <link rel="icon"
          href="{{ asset('images/favicon/favicon-32x32.png') }}"
          type="image/png"
          sizes="32x32">

    <link rel="icon"
          href="{{ asset('images/favicon/favicon-16x16.png') }}"
          type="image/png"
          sizes="16x16">

    <link rel="apple-touch-icon"
          href="{{ asset('images/favicon/apple-touch-icon.png') }}"
          sizes="180x180">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('admin') }}{% endblock %}
    {% endblock %}

</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
