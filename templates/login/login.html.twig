{% extends 'base.html.twig' %}

{% block title %}Login | YAP{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}

{% block body %}
<main class="login-page">
    <div class="login-container">
        <div class="login-card">
            <div class="login-logo">
                <img src="{{ asset('images/logo/yap-logo.svg') }}" alt="YAP – Yet another PIM" >
            </div>

            <form method="post">
                <div class="login-header">
                    <h1>Welcome back</h1>
                    <p>Sign in to continue to YAP</p>
                </div>

                {% if error %}
                    <div class="alert alert-danger" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="login-user-info">
                        You are logged in as
                        <strong>{{ app.user.userIdentifier }}</strong>.
                        <a href="{{ logout_path() }}">Logout</a>
                    </div>
                {% endif %}

                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus >
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required >
                </div>

                <div class="form-group">
                    <label for="_locale">Language</label>
                    <select name="_locale" id="_locale" class="form-select" >
                        {% for locale in locales %}
                            <option value="{{ locale.getId() }}"> {{ locale.getId() }} {% if locale.isDefault() %} (default) {% endif %} </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="login-options">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me" >
                        <label class="form-check-label" for="_remember_me" > Remember me </label>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button class="btn-login" type="submit"> Sign in </button>

            </form>

        </div>

        <div class="login-footer"> Yet another PIM </div>
    </div>
</main>
{% endblock %}
