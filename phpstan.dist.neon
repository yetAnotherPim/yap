parameters:
    doctrine:
        objectManagerLoader: tests/object-manager.php
    level: max
    bootstrapFiles:
        - ./vendor/autoload.php
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        - tests/bootstrap.php
        - tests/object-manager.php
        - config/reference.php
    treatPhpDocTypesAsCertain: false
